# ==============================================================================
# APPLICATION CONFIGURATION
# ==============================================================================
APP_NAME="Zoom POS SaaS"
APP_VERSION=1.0.4
NATIVEPHP_APP_ID=com.zoomnearby.zoompos
NATIVEPHP_DEEPLINK_SCHEME=zoompos
NATIVEPHP_APP_AUTHOR="Zoomnearby Digital Store"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com
DEMO_MODE=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Logging Configuration
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ==============================================================================
# DATABASE CONFIGURATION
# Supported: mysql, mariadb, pgsql, sqlite
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

# ==============================================================================
# SESSION & CACHE CONFIGURATION
# Supported drivers: file, database, redis, cookie, array
# `file` is the shipped default deliberately — `database` needs a `sessions`
# table that only exists AFTER the /install wizard's migrate step has run,
# so a database session driver 500s the installer's very first page (and
# every other page) on a fresh install. Switch to `database`/`redis` once
# the app is installed if you want sessions to survive a server restart.
# ==============================================================================
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
# CACHE_PREFIX=zoom_pos_

QUEUE_CONNECTION=database

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
FILESYSTEM_DISK=public

# ==============================================================================
# REDIS (Optional for High-Performance Caching & Queues)
# ==============================================================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==============================================================================
# MAIL / SMTP NOTIFICATIONS
# Supported: smtp, sendmail, mailgun, ses, postmark, log
# ==============================================================================
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="support@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================================================
# PAYMENT GATEWAYS (Platform SaaS Subscriptions & Invoicing)
# ==============================================================================
# Stripe
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox # sandbox or live

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Mercado Pago
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=

# ==============================================================================
# LICENSE VERIFICATION
# The license server is hardcoded to https://license.zoomnearby.com
# (config/services.php). Only the shared secret is set here — it must equal the
# SERVER_SECRET in the License Manager's config/config.php.
# ==============================================================================
LICENSE_SERVER_SECRET=
LICENSE_SERVER_TIMEOUT=10

# ==============================================================================
# FRONTEND ASSET CONFIGURATION (Vite)
# ==============================================================================
VITE_APP_NAME="${APP_NAME}"
