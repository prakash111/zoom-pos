# ==============================================================================
# APPLICATION CONFIGURATION
# ==============================================================================
APP_NAME="Zoom POS SaaS"
APP_VERSION=1.0.4
NATIVEPHP_APP_ID=com.zoomnearby.zoompos
NATIVEPHP_DEEPLINK_SCHEME=zoompos
NATIVEPHP_APP_AUTHOR="Zoomnearby Digital Store"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com
DEMO_MODE=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Logging Configuration
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ==============================================================================
# DATABASE CONFIGURATION
# Supported: mysql, mariadb, pgsql, sqlite
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

# ==============================================================================
# SESSION & CACHE CONFIGURATION
# Supported drivers: file, database, redis, cookie, array
# ==============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
# CACHE_PREFIX=zoom_pos_

QUEUE_CONNECTION=database

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
FILESYSTEM_DISK=public

# ==============================================================================
# REDIS (Optional for High-Performance Caching & Queues)
# ==============================================================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==============================================================================
# MAIL / SMTP NOTIFICATIONS
# Supported: smtp, sendmail, mailgun, ses, postmark, log
# ==============================================================================
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="support@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================================================
# PAYMENT GATEWAYS (Platform SaaS Subscriptions & Invoicing)
# ==============================================================================
# Stripe
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox # sandbox or live

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Mercado Pago
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=

# ==============================================================================
# ENVATO & CODECANYON LICENSE VERIFICATION
# Optional: Set your Envato API Personal Token for live author validation
# ==============================================================================
ENVATO_API_TOKEN=
ENVATO_ITEM_ID=

# ==============================================================================
# LICENSE VERIFICATION  (vendor configuration — set before distributing the script)
# There is NO in-app licensing screen. Buyers only enter the license keys you
# issue them (core script + each module) on the install wizard / Modules page.
#   LICENSE_DRIVER      "custom" (your self-hosted license server) or
#                       "codecanyon" (Envato Market API)
#   LICENSE_SERVER_URL  base URL of your license server. Empty => keys are only
#                       format-checked (dev / offline).
#   LICENSE_SERVER_SECRET  shared secret, must equal the server's SERVER_SECRET.
# ==============================================================================
LICENSE_DRIVER=custom
LICENSE_SERVER_URL=
LICENSE_SERVER_SECRET=
LICENSE_SERVER_TIMEOUT=10

# ==============================================================================
# FRONTEND ASSET CONFIGURATION (Vite)
# ==============================================================================
VITE_APP_NAME="${APP_NAME}"
