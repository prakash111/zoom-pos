# ==============================================================================
# Zoom POS App Builder - Environment Configuration Template
# ==============================================================================

# Application Settings
APP_NAME="Zoom POS App Builder"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.com/app-builder

# Database Connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

# Central License Server (Validates Main Core Script Licenses)
LICENSE_SERVER_URL=https://license.zoomnearby.com
LICENSE_SERVER_SECRET=N4jJ8R2pyZWTpp4oghrq

# GitHub Actions Cloud Engine (Compile pipeline for Android, Web, Windows, iOS)
GITHUB_REPO=prakash111/zoom-pos
GITHUB_BRANCH=feat/windows-offline-sync
GITHUB_TOKEN=your_github_personal_access_token

# Default Quotas & Limits
BUILDER_DEFAULT_MONTHLY_LIMIT=10

# Email Notifications (Sent to license-linked email when build finishes)
MAIL_FROM_ADDRESS=licenses@your-domain.com
MAIL_FROM_NAME="Zoom POS App Builder"
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
